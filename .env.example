# Copy to .env and fill in. Never commit .env. See DEPLOY.md for meanings.
NODE_ENV=development

# Telegram
BOT_TOKEN=123456:replace-with-dev-bot-token
WEBHOOK_SECRET=replace-with-random-string
PUBLIC_URL=https://example.ir
OWNER_TELEGRAM_IDS=111111111,222222222
CHANNEL_ID=@your_channel
BACKUP_CHANNEL_ID=-1000000000000

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://abis:change-me@localhost:5432/abis

# Secrets (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=
BACKUP_PASSPHRASE=
